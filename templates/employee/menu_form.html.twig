{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	{{ form_start(form) }}
		{{ form_widget(form) }}
		<button type="submit">Enregistrer</button>
	{{ form_end(form) }}

	{% if menu is defined %}
		<a href="{{ path('employee_menu_images', {id: menu.id}) }}">Gérer les images</a>
	{% endif %}

	<a href="{{ path('employee_menu_list') }}">Retour à la liste</a>
{% endblock %}
