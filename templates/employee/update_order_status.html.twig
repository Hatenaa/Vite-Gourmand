{% extends 'base.html.twig' %}

{% set statusLabels = {
    'PENDING': 'En attente',
    'ACCEPTED': 'Acceptée',
    'IN_PREPARATION': 'En préparation',
    'IN_DELIVERY': 'En cours de livraison',
    'DELIVERED': 'Livrée',
    'WAITING_MATERIAL': 'En attente retour matériel',
    'COMPLETED': 'Terminée',
    'CANCELLED': 'Annulée'
} %}

{% block header %}{% endblock %}

{% block title %}Mettre à jour la commande
{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/glass-kitchen.jpg" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		<div class="position-relative z-1 d-flex justify-content-between align-items-center py-4 px-3 container">
			{% include 'admin/_partials/_nav.html.twig' %}
		</div>

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">Mettre à jour cette commande</h1>
				<p class="lead text-white mb-0">
					effectuée par
					{{ order.firstName }}
					{{ order.lastName }}
				</p>
			</div>

			<div class="d-grid gap-2 d-md-flex">
				<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
					<i class="bi bi-person-workspace"></i>
					Espace employé
				</a>
				<a href="{{ path('employee_cancel_order', {id: order.id}) }}" class="btn btn-outline-light">
					Annuler cette commande
				</a>
			</div>

		</div>

	</section>

	<main class="container py-4">
		<h2>Détails de la commande</h2>

		<div class="py-3">
			<span class="badge bg-dark">Menu
				{{ order.menu.title }}</span>
			<span class="badge bg-primary">{{ statusLabels[order.status] ?? order.status }}</span>
		</div>

		{{ form_start(form) }}

		<div class="row g-3">
			<div class="col-12 col-md-6">
				{{ form_label(form.status, 'Nouveau statut', {'label_attr': {'class': 'form-label'}}) }}
				{{ form_widget(form.status, 
                        { 
                            'attr': {
                                'class': 'form-select',
                                'data-validate': 'status',
                            }
                        }
                    ) 
                }}
                <div class="invalid-feedback" data-feedback="status">
                    Veuillez sélectionner un statut.
                </div>
			</div>
			<div class="col-12 col-md-6">
				{{ form_label(form.contactMode, 'Mode de contact', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.contactMode,
                        {
                            'attr': {
                                'class': 'form-select',
                                'data-validate': 'contactMode',
                            }
                        }
                    ) 
                }}
                <div class="invalid-feedback" data-feedback="contactMode">
                    Veuillez sélectionner un mode de contact.
                </div>
			</div>
		</div>

		<div class="row g-3 mt-2">
			<div class="col-12">
				{{ form_label(form.reason, 'Motif', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.reason, 
                        {
                            'attr': {
                                'class': 'form-control',
                                'rows': 3,
                                'data-validate': 'reason'
                            }
                        }
                    ) 
                }}
			</div>
		</div>

		<div class="row g-3 mt-2">
			<div class="col-12 col-md-3">
				<button class="btn btn-primary w-100" type="submit" data-spinner-btn>
					<span class="btn-label">Mettre à jour</span>
					<span class="btn-spinner p-1 d-none justify-content-center">
						<span class="spinner-border spinner-border-sm" role="status">
							<span class="visually-hidden">Loading...</span>
						</span>
					</span>
				</button>
			</div>
		</div>

		{{ form_end(form) }}
	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('update-order') }}
{% endblock %}
