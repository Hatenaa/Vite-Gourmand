{% extends 'base.html.twig' %}

{% set statusLabels = {
    'PENDING': 'En attente',
    'ACCEPTED': 'Acceptée',
    'IN_PREPARATION': 'En préparation',
    'IN_DELIVERY': 'En cours de livraison',
    'DELIVERED': 'Livrée',
    'WAITING_MATERIAL': 'En attente retour matériel',
    'COMPLETED': 'Terminée',
    'CANCELLED': 'Annulée'
} %}

{% block header %}{% endblock %}

{% block title %}Mettre à jour la commande
{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/glass-kitchen.jpg" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		<div class="position-relative z-1 d-flex justify-content-between align-items-center py-4 px-3 container">
			{% include 'admin/_partials/_nav.html.twig' %}
		</div>

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">Mettre à jour cette commande</h1>
				<p class="lead text-white mb-0">
					effectuée par {{ order.firstName }} {{ order.lastName }}
				</p>
			</div>

			<div class="d-grid gap-2 d-md-flex">
				<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
					<i class="bi bi-person-workspace"></i>
					Espace employé
				</a>
			</div>

		</div>

	</section>

	<p>Client:
		{{ order.firstName }}
		{{ order.lastName }}</p>
	<p>Menu:
		{{ order.menu.title }}</p>
	<p>Statut actuel:
		{{ statusLabels[order.status] ?? order.status }}</p>

	{{ form_start(form) }}
	{{ form_row(form.status) }}
	{{ form_row(form.contactMode) }}
	{{ form_row(form.reason) }}
	<button type="submit">Mettre à jour</button>
	{{ form_end(form) }}

{% endblock %}
