{% extends 'base.html.twig' %}

{% block header %}{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/catering-tables.jpg" alt="Catering" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		<div class="position-relative z-1 d-flex justify-content-between align-items-center py-4 px-3 container">
			{% include 'admin/_partials/_nav.html.twig' %}
		</div>

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">{{ title }}</h1>
				<p class="lead text-white mb-0">
					Gérez les informations de votre plat
				</p>
			</div>
			<div class="d-grid gap-2 d-md-flex">
				<div class="d-grid gap-2 d-md-flex">
					<a href="{{ path('employee_dish_list') }}" class="btn btn-outline-light">
						<i class="bi bi-arrow-left"></i>
						Retour aux plats
					</a>
				</div>
				<div class="d-grid gap-2 d-md-flex">
					<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
						<i class="bi bi-person-workspace"></i>
						Espace employé
					</a>
				</div>
			</div>

		</div>

	</section>

	<main class="container">
		<div class="container py-5">

			{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
			{{ form_errors(form) }}

			<div class="row">
				<div class="col-lg-6 pe-4 pb-4">
					<h4 class="mb-3">Informations du plat</h4>

					{# if dish is defined and dish.image %}
														<div class="row mb-3">
															<div class="col-12">
																<img src="{{ asset('uploads/dishes/' ~ dish.image) }}" alt="{{ dish.title }}" class="rounded" style="max-width: 100%; max-height: 300px; object-fit: cover;">
															</div>
														</div>
														{% endif #}


					<div class="row mb-3">
						<div class="col-12">
							{{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
							<div class="invalid-feedback">Veuillez sélectionner une image</div>
							{{ form_errors(form.imageFile) }}
						</div>
					</div>


					<div class="row">
						<div class="col-md-6 mb-3">
							{{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Côte de boeuf'}}) }}
							<div class="invalid-feedback">Ce champ est requis</div>
							{{ form_errors(form.title) }}
						</div>
						<div class="col-md-6 mb-3">
							{{ form_label(form.type, null, {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
							<div class="invalid-feedback">Veuillez sélectionner un type</div>
							{{ form_errors(form.type) }}
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-12">
							{{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Décrivez votre plat...'}}) }}
							{{ form_errors(form.description) }}
						</div>
					</div>


					<div class="d-flex gap-3 mt-4 flex-column flex-lg-row">
						<button type="submit" class="btn btn-primary w-100 flex-lg-1" data-spinner-btn>
							<span class="btn-label">
								{% if dish is defined %}
									Enregistrer les modifications
								{% else %}
									Créer le plat
								{% endif %}
							</span>
							<span class="btn-spinner p-1 d-none justify-content-center">
								<span class="spinner-border spinner-border-sm" role="status">
									<span class="visually-hidden">Loading...</span>
								</span>
							</span>
						</button>
					</div>

				</div>

				<div class="col-lg-6">
					<h4 class="mb-3">Allergènes</h4>
					<div class="border rounded overflow-y-auto" style="max-height: 500px;">
						<ul class="list-group list-group-flush">
							{% for allergen_field in form.allergens %}
								<li class="list-group-item">
									{{ form_widget(allergen_field, {'attr': {'class': 'form-check-input me-2'}}) }}
									{{ form_label(allergen_field, null, {'label_attr': {'class': 'form-check-label'}}) }}
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>

			{{ form_end(form) }}

		</div>
	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
{% endblock %}
