{% extends 'base.html.twig' %}

{% block title %}Gestion des images {{ menu.title }}{% endblock %}

{% block header %}{% endblock %}

{% block body %}

<section class="position-relative overflow-hidden d-flex flex-column justify-content-between"
	style="min-height: 380px;">
	<img src="/images/main/glass-kitchen.jpg"
		class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
	<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

	{% include '_partials/_nav.html.twig' %}

	<div
		class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
		<div>
			<h1 class="fw-bold text-white">Images du menu {{ menu.title }}</h1>
			<p class="lead text-white mb-0">
				Gérez les images de votre menu
			</p>
		</div>

		<div class="d-grid gap-2 d-md-flex">
			<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
				<i class="bi bi-person-workspace"></i>
				Espace employé
			</a>
		</div>

	</div>

</section>
<main class="container">

	{% include 'employee/_partials/_items.html.twig' %}

	<div class="mb-5">
		<h2 class="pb-2 mb-4">Ajouter une image</h2>
		{{ form_start(form, {'action': path('employee_menu_image_add', {'id': menu.id}), 'attr': {'novalidate': 'novalidate'}}) }}
			<div class="row g-3">
				<div class="col-12">
					{{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label'}}) }}
					{{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
					<div class="invalid-feedback">Veuillez sélectionner une image</div>
					{{ form_errors(form.imageFile) }}
				</div>

				<div class="col-md-6">
					{{ form_label(form.alt, null, {'label_attr': {'class': 'form-label'}}) }}
					{{ form_widget(form.alt, {'attr': {'class': 'form-control', 'placeholder': 'ex: présentation du Menu de Noël'}}) }}
					{{ form_errors(form.alt) }}
				</div>


				<div class="col-md-6">
					{{ form_label(form.position, null, {'label_attr': {'class': 'form-label'}}) }}
					{{ form_widget(form.position, {'attr': {'class': 'form-control', 'type': 'number', 'min': '0'}}) }}
					<div class="invalid-feedback">Doit être un nombre positif</div>
					{{ form_errors(form.position) }}
				</div>


				<div class="col-12 col-md-3 pt-2">
                    <button type="submit" class="btn btn-primary w-100" data-spinner-btn>

                        <span class="btn-label">
                            <i class="bi bi-cloud-upload"></i>
                            Ajouter l'image
                        </span>
                        <span class="btn-spinner p-1 d-none justify-content-center">
                            <span class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </span>
                        </span>
                    </button>
                </div>


			</div>
		{{ form_end(form) }}
	</div>

	<div>
		<h2>Images existantes</h2>
		{% if menu.images|length > 0 %}
			<div class="row row-cols-1 row-cols-lg-3 align-items-stretch g-4 pt-3">
				{% for image in menu.images %}
					<div class="col">
						<div class="card card-cover h-100 overflow-hidden text-bg-dark rounded-4 shadow-lg position-relative" style="background-image: url('{{ asset(image.path) }}'); background-size: cover; background-position: center; min-height: 280px;">
							<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
							
							<div class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1 position-relative z-1">
								
								
								<div class="mt-auto pt-3">
									{# <span class="badge bg-light text-bg-light w-25">Position {{ image.position }}</span> #}
									<form method="post" action="{{ path('employee_menu_image_delete', {'id': menu.id, 'imageId': image.id}) }}" class="mt-3">
										<input type="hidden" name="_token" value="{{ csrf_token('delete_menu_image' ~ image.id) }}">
										<button type="submit" class="btn btn-danger w-100">
											Supprimer
										</button>
									</form>
								</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<div class="alert alert-info">
				<i class="bi bi-info-circle"></i>
				Aucune image pour ce menu. Commencez par en ajouter une.
			</div>
		{% endif %}
	</div>

</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('menu-images') }}
{% endblock %}