{% extends 'base.html.twig' %}

{% block header %}{% endblock %}

{% block body %}

<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
	<img src="/images/main/glass-kitchen.jpg" alt="Kitchen" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
	<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

	{% include '_partials/_nav.html.twig' %}

	<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
		<div>
			<h1 class="fw-bold text-white">{{ title }}</h1>
			<p class="lead text-white mb-0">Gérez les horaires d'ouverture de votre restaurant.</p>
		</div>

		<div class="d-grid gap-2 d-md-flex">
			<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
				<i class="bi bi-person-workspace"></i>
				Espace employé
			</a>
		</div>

	</div>

</section>

<main class="container">

	{% include 'employee/_partials/_items.html.twig' %}

	<div class="d-flex justify-content-center pb-5 pt-5">
		<div class="card col-sm-6">
			<div class="p-4 card-body">

				{{ form_start(form) }}
				{{ form_errors(form) }}

				<div class="mb-3">
					{{ form_label(form.openingTime, null, {'label_attr': {'class': 'form-label'}}) }}
					{{ form_widget(form.openingTime, {'attr': {'class': 'form-control', 'data-validate': 'opening-time'}}) }}
					<div class="invalid-feedback" id="openingTimeFeedback">Veuillez renseigner une heure d'ouverture.</div>
					{{ form_errors(form.openingTime) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.closingTime, null, {'label_attr': {'class': 'form-label'}}) }}
					<div class="input-group">
						{{ form_widget(form.closingTime, {'attr': {'class': 'form-control rounded-end-0', 'data-validate': 'closing-time'}}) }}
						{{ form_widget(form.isClosed, {'attr': {'class': 'btn-check', 'autocomplete': 'off', 'data-validate': 'is-closed', 'id': form.isClosed.vars.id}}) }}
						<label class="btn btn-outline-danger rounded-end" for="{{ form.isClosed.vars.id }}">Fermé ce jour</label>
						<div class="invalid-feedback" id="closingTimeFeedback">Veuillez renseigner une heure de fermeture.</div>
					</div>
					
					{{ form_errors(form.closingTime) }}
					{{ form_errors(form.isClosed) }}
				</div>

				<button type="submit" id="submitBtn" class="btn btn-primary w-100 mt-3" data-spinner-btn disabled>
					<span class="btn-label">Enregistrer</span>
					<span class="btn-spinner p-1 d-none justify-content-center">
						<span class="spinner-border spinner-border-sm" role="status">
							<span class="visually-hidden">Loading...</span>
						</span>
					</span>
				</button>

				{{ form_end(form) }}

			</div>
		</div>
	</div>
</main>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('opening-hours-form') }}
{% endblock %}