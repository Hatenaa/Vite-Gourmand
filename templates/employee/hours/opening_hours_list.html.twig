{% extends 'base.html.twig' %}

{% block header %}{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/glass-kitchen.jpg" alt="Kitchen" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		{% include '_partials/_nav.html.twig' %}

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">Gérer les horaires</h1>
				<p class="lead text-white mb-0">Définissez les horaires d'ouverture et de fermeture de votre restaurant.</p>
			</div>

			<div class="d-grid gap-2 d-md-flex">
				<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
					<i class="bi bi-person-workspace"></i>
					Espace employé
				</a>
			</div>

		</div>

	</section>

	<main class="container">

		{% include 'employee/_partials/_items.html.twig' %}

		{% if opening_hours is empty %}
			<p class="text-muted pt-4">Aucun horaire enregistré.</p>
		{% else %}
			<div class="d-flex flex-column gap-3 pt-4">
				{% for opening_hour in opening_hours %}
					<div class="card shadow-sm">
						<div class="card-body p-3 p-md-4">

							<div class="d-flex align-items-center gap-3 justify-content-between">

								<div class="flex-grow-1">
									<h6 class="mb-2 fw-bold">{{ opening_hour.day }}</h6>
									<small class="text-muted d-flex align-items-center gap-2">
										{% if opening_hour.isClosed %}
											<span class="badge bg-primary">
												<i class="bi bi-door-closed"></i>
												Fermé
											</span>
										{% else %}
											<span class="badge bg-dark">
												<i class="bi bi-door-open"></i>
												Ouvert
											</span>
											<i class="bi bi-clock"></i>
											{{ opening_hour.openingTime|date('H:i') }}
											-
											{{ opening_hour.closingTime|date('H:i') }}
										{% endif %}
									</small>
								</div>

								{# Desktop #}
								<div class="d-none d-lg-flex align-items-center gap-2 flex-shrink-0">
									<a href="{{ path('employee_opening_hours_edit', {id: opening_hour.id}) }}" class="btn btn-outline-secondary">Modifier</a>
								</div>

							</div>

							{# Mobile #}
							<div class="d-flex d-lg-none flex-column gap-2 mt-3 pt-3 border-top">
								<a href="{{ path('employee_opening_hours_edit', {id: opening_hour.id}) }}" class="btn btn-outline-secondary w-100">Modifier</a>
							</div>

						</div>
					</div>

				{% endfor %}
			</div>
		{% endif %}

	</main>

{% endblock %}
