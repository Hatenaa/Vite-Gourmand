{% extends 'base.html.twig' %}

{% set statusLabels = {
    'PENDING': 'En attente',
    'ACCEPTED': 'Acceptée',
    'IN_PREPARATION': 'En préparation',
    'IN_DELIVERY': 'En cours de livraison',
    'DELIVERED': 'Livrée',
    'WAITING_MATERIAL': 'En attente retour matériel',
    'COMPLETED': 'Terminée',
    'CANCELLED': 'Annulée'
} %}

{% set statusColors = {
    'PENDING': 'dark',
    'ACCEPTED': 'info',
    'IN_PREPARATION': 'primary',
    'IN_DELIVERY': 'primary',
    'DELIVERED': 'success',
    'WAITING_MATERIAL': 'secondary',
    'COMPLETED': 'success',
    'CANCELLED': 'danger'
} %}

{% block header %}{% endblock %}

{% block title %}Espace employé
{% endblock %}


{% block body %}
	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/front-restaurant.jpg" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		<div class="position-relative z-1 d-flex justify-content-between align-items-center py-4 px-3 container">
			{% include 'admin/_partials/_nav.html.twig' %}
		</div>

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">Espace employé</h1>
				<p class="lead text-white mb-0">
					Retrouvez vos données professionnelles et les ressources nécessaires à votre activité.
				</p>
			</div>

			<div
				class="d-grid d-md-block">

				{# Boutton de filtrage #}
				<button class="btn btn-outline-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
					Filtrer les commandes
				</button>

				{# Canva de filtrage des commandes #}
				<div class="offcanvas offcanvas-end p-3" id="filterOffcanvas" tabindex="-1" aria-labelledby="filterOffcanvasLabel">
					<div class="offcanvas-header">
						<h5 class="offcanvas-title" id="filterOffcanvasLabel">Filtrer les commandes</h5>
						<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
					</div>
					<div class="offcanvas-body">
						<form id="filter-form" class="d-flex flex-column gap-4">

							<div>
								<label for="filter-status" class="fw-semibold mb-2 d-block">Statut</label>
								<select id="filter-status" name="status" class="form-select">
									<option value="">Tous les statuts</option>
									<option value="PENDING" {% if currentStatus == 'PENDING' %} selected {% endif %}>En attente</option>
									<option value="ACCEPTED" {% if currentStatus == 'ACCEPTED' %} selected {% endif %}>Acceptée</option>
									<option value="IN_PREPARATION" {% if currentStatus == 'IN_PREPARATION' %} selected {% endif %}>En préparation</option>
									<option value="IN_DELIVERY" {% if currentStatus == 'IN_DELIVERY' %} selected {% endif %}>En cours de livraison</option>
									<option value="COMPLETED" {% if currentStatus == 'COMPLETED' %} selected {% endif %}>Terminée</option>
									<option value="CANCELLED" {% if currentStatus == 'CANCELLED' %} selected {% endif %}>Annulée</option>
								</select>
							</div>

							<div>
								<label for="filter-email" class="fw-semibold mb-2 d-block">Email client</label>
								<select id="filter-email" name="email" class="form-select">
									<option value="">Tous les clients</option>
								</select>
							</div>

							<div class="d-flex flex-column gap-1">
								<button type="button" class="btn btn-outline-dark" id="reset-filters">
									<i class="bi bi-arrow-counterclockwise"></i>
									Réinitialiser le filtre
								</button>
							</div>

						</form>
					</div>
				</div>

			</div>
		</div>

	</section>

	{% include 'admin/_partials/_offcanvas.html.twig' %}

	<div class="container py-5">
		<div class="mb-5">
			<div class="row g-3">
				<div class="col-12 col-md-3">
					<a href="{{ path('employee_review_list') }}" class="btn btn-outline-secondary w-100">
						<i class="bi bi-chat-left-text me-1"></i>Avis à valider
					</a>
				</div>
				<div class="col-12 col-md-3">
					<a href="{{ path('employee_menu_list') }}" class="btn btn-outline-secondary w-100">
						<i class="bi bi-list-ul me-1"></i>Gérer les menus
					</a>
				</div>
				<div class="col-12 col-md-3">
					<a href="{{ path('employee_dish_list') }}" class="btn btn-outline-secondary w-100">
						<i class="bi bi-cup-straw me-1"></i>Gérer les plats
					</a>
				</div>
				<div class="col-12 col-md-3">
					<a href="{{ path('employee_opening_hours_list') }}" class="btn btn-outline-secondary w-100">
						<i class="bi bi-clock me-1"></i>Gérer les horaires
					</a>
				</div>
			</div>
		</div>


		<h2 class="mb-4">Commandes</h2>

		{% if orders is empty %}
			<p class="text-muted">Aucune commande trouvée.</p>
		{% else %}
			<div class="d-flex flex-column gap-3" id="orders-list">
				{% for order in orders %}
					<div class="card shadow-sm">
						<div class="card-body p-3 p-md-4">

							<div class="d-flex align-items-center gap-3">
								{% if order.menu.images|length > 0 %}
									{% set menuImage = order.menu.images|first %}
									<img src="{{ asset(menuImage.path) }}" alt="{{ menuImage.alt ?? order.menu.title }}" class="rounded flex-shrink-0 object-fit-cover" style="width: 55px; height: 55px;">
								{% endif %}
								<div class="flex-grow-1 min-w-0">
									<h6 class="mb-1 fw-bold text-truncate">{{ order.menu.title }}</h6>
									<small class="text-muted">
										<i class="bi bi-person me-1"></i>
										{{ order.firstName }}
										{{ order.lastName }}
										&nbsp;·&nbsp;
										<i class="bi bi-calendar me-1"></i>
										{{ order.deliveryDate|date('d/m/Y') }}
										&nbsp;·&nbsp;
										<i class="bi bi-people me-1"></i>
										{{ order.peopleCount }}
										pers.
									</small>
								</div>

								{# Desktop uniquement : badge + prix + bouton Gérer #}
								<div class="d-none d-lg-flex align-items-center gap-3 flex-shrink-0">
									<span class="badge bg-{{ statusColors[order.status] ?? 'secondary' }}">
										{{ statusLabels[order.status] ?? order.status }}
									</span>
									<strong>{{ order.totalPrice|number_format(2, '.', ' ') }}
										€</strong>
									<a href="{{ path('employee_update_order_status', {id: order.id}) }}" class="btn btn-outline-primary">
										<i class="bi bi-pencil me-1"></i>Gérer
									</a>
								</div>
							</div>

							{# Mobile uniquement #}
							<div class="d-flex d-lg-none flex-column gap-2 mt-2 pt-2 border-top">
								<div class="d-flex align-items-center justify-content-between py-3">
									<span class="badge bg-{{ statusColors[order.status] ?? 'secondary' }}">
										{{ statusLabels[order.status] ?? order.status }}
									</span>
									<strong>{{ order.totalPrice|number_format(2, '.', ' ') }}
										€</strong>
								</div>
								<a href="{{ path('employee_update_order_status', {id: order.id}) }}" class="btn btn-outline-primary w-100">
									<i class="bi bi-pencil me-1"></i>Gérer cette commande
								</a>
							</div>

						</div>
					</div>
				{% endfor %}
			</div>
		{% endif %}

	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('order-filters') }}
{% endblock %}
