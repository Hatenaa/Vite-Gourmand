{% extends 'base.html.twig' %}

{% block title %}Gestion des comptes employés{% endblock %}

{% block body %}
    <h1>Comptes employés</h1>
    <a href="{{ path('admin_account_create') }}">Créer un compte</a>

    {% if employees is empty %}
        <p>Aucun compte employé.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for employee in employees %}
                    <tr>
                        <td>{{ employee.lastName }}</td>
                        <td>{{ employee.firstName }}</td>
                        <td>{{ employee.email }}</td>
                        <td>{{ employee.isActive ? 'Actif' : 'Désactivé' }}</td>
                        <td>
                            <a href="{{ path('admin_account_edit', {id: employee.id}) }}">Modifier</a>

                            <form method="post" action="{{ path('admin_account_toggle', {id: employee.id}) }}">
                                <button type="submit">
                                    {{ employee.isActive ? 'Désactiver' : 'Activer' }}
                                </button>
                            </form>

                            <form method="post" action="{{ path('admin_account_delete', {id: employee.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_employee_' ~ employee.id) }}">
                                <button type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

{% endblock %}