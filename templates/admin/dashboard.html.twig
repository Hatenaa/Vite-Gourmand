{% extends 'base.html.twig' %}

{% block title %}Espace administrateur
{% endblock %}

{% block header %}{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/restaurant-lights.jpg" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		{% include '_partials/_nav.html.twig' %}

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">Espace administrateur</h1>
				<p class="lead text-white mb-0">Bienvenue,
					{{ app.user.firstName }}.</p>
			</div>
			<div class="d-grid gap-2 d-md-flex">
				<a href="{{ path('admin_stats_index') }}" class="btn btn-outline-light">
					<i class="bi bi-graph-up-arrow"></i>
					Statistiques
				</a>
				<a href="{{ path('employee_dashboard') }}" class="btn btn-outline-light">
					<i class="bi bi-person-workspace"></i>
					Espace employé
				</a>
			</div>

		</div>

	</section>

	{% include '_partials/_offcanvas.html.twig' %}

	{# On va afficher la liste des employés ici} #}
	<main class="container">

		{% include 'admin/_partials/_account_list.html.twig' %}

	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
{% endblock %}
