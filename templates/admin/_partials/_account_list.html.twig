{% extends 'base.html.twig' %}

{% block title %}Gestion des comptes employés
{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}


	<div class="d-flex justify-content-between align-items-center mb-4 pt-4">
		<h2 class="mb-0">Comptes employés</h2>
		<a href="{{ path('admin_create') }}" class="btn btn-primary">
			<i class="bi bi-person-fill-add"></i>
			Créer un compte
		</a>
	</div>

	{% if employees is empty %}
		<p class="text-muted">Aucun compte employé.</p>
	{% else %}
		<div class="d-flex flex-column gap-3">
			{% for employee in employees %}
				<div class="card shadow-sm">
					<div class="card-body p-3 p-md-4">

						<div class="d-flex align-items-center gap-3">

							<div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center flex-shrink-0" style="width:55px;height:55px;">
								<i class="bi bi-person fs-4 text-secondary"></i>
							</div>

							<div class="flex-grow-1 min-w-0">
								<h6 class="mb-1 fw-bold">{{ employee.firstName }}
									{{ employee.lastName }}</h6>
								<small class="text-muted">{{ employee.email }}</small>
							</div>

							{# Desktop #}
							<div class="d-none d-lg-flex align-items-center gap-3 flex-shrink-0">
								<span class="badge bg-dark">
									{{ employee.isActive ? 'Actif' : 'Désactivé' }}
								</span>
								<a href="{{ path('admin_edit', {id: employee.id}) }}" class="btn btn-outline-secondary">Modifier</a>
								<form method="post" action="{{ path('admin_toggle', {id: employee.id}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('toggle_employee_' ~ employee.id) }}">
									<button type="submit" class="btn btn-outline-secondary">
										{{ employee.isActive ? 'Désactiver' : 'Activer' }}
									</button>
								</form>

								{# Bouton de suppression sur desktop #}
								<button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ employee.id }}">
									Supprimer
								</button>


							</div>


							<div class="modal fade" id="deleteModal{{ employee.id }}" tabindex="-1" aria-hidden="true">
								<div class="modal-dialog modal-dialog-centered">
									<div class="modal-content rounded-4 border-0 shadow">
										<div class="modal-header border-0 pb-0">
											<h5 class="modal-title fw-bold">Supprimer le compte</h5>
											<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
										</div>
										<div class="modal-body">
											<p>Êtes-vous sûr de vouloir supprimer le compte de
												<strong>{{ employee.firstName }}
													{{ employee.lastName }}</strong>
												?</p>
											<p class="text-muted small mb-0">Cette action est irréversible. Le compte ne pourra pas être restauré. Il faudra en créer un nouveau si nécessaire.</p>
										</div>
										<div class="modal-footer border-0 pt-0">
											<div class="d-flex gap-2 w-100">
												<button type="button" class="btn btn-danger flex-fill" data-bs-dismiss="modal">Annuler</button>
												<form method="post" action="{{ path('admin_delete', {id: employee.id}) }}" class="flex-fill">
													<input type="hidden" name="_token" value="{{ csrf_token('delete_employee_' ~ employee.id) }}">
													<button type="submit" class="btn btn-outline-secondary w-100">Supprimer définitivement</button>
												</form>
											</div>
										</div>

									</div>
								</div>
							</div>

						</div>

						{# Mobile #}
						<div class="d-flex d-lg-none flex-column gap-2 mt-2 pt-2 border-top">
							<div class="d-flex align-items-center py-2">
								<span class="badge bg-{{ employee.isActive ? 'dark' : 'primary' }}">
									{{ employee.isActive ? 'Actif' : 'Désactivé' }}
								</span>
							</div>
							<div class="d-flex gap-2 flex-wrap">
								<a href="{{ path('admin_edit', {id: employee.id}) }}" class="btn btn-outline-secondary">Modifier</a>
								<form method="post" action="{{ path('admin_toggle', {id: employee.id}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('toggle_employee_' ~ employee.id) }}">
									<button type="submit" class="btn btn-outline-secondary">
										{{ employee.isActive ? 'Désactiver' : 'Activer' }}
									</button>
								</form>
								<button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ employee.id }}">
									Supprimer
								</button>
							</div>
						</div>


					</div>
				</div>
			{% endfor %}
		</div>
	{% endif %}


{% endblock %}
