{% extends 'base.html.twig' %}

{% block title %}Laisser un avis
{% endblock %}

{% block header %}{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex flex-column justify-content-between" style="min-height: 380px;">
		<img src="/images/main/saipano-glass.jpg" alt="" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover hero-parallax">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

		{% include '_partials/_nav.html.twig' %}

		<div class="position-relative z-1 py-5 px-3 container d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3">
			<div>
				<h1 class="fw-bold text-white">Laisser un avis</h1>
				<p class="lead text-white mb-0">Commande du menu
					{{ order.menu.title }}
					effectuée le
					{{ order.deliveryDate|date('d/m/Y') }}</p>
			</div>
			<div class="d-grid d-md-block">
				<a href="{{ path('user_dashboard') }}" class="btn btn-outline-light">
					<i class="bi bi-arrow-left me-1"></i>
					Retour
				</a>
			</div>
		</div>
	</section>

	<main class="container pt-5">
		<div class="d-flex justify-content-center pb-5">
			<div class="card col-sm-4">
				<div class="p-4 card-body">
					{{ form_start(form) }}

					<div class="mb-3">
						{{ form_label(form.note, null, {'label_attr': {'class': 'form-label'}}) }}
						{{ form_widget(form.note, {'attr': {'class': 'form-control', 'data-validate': 'note'}}) }}
						<div class="invalid-feedback">La note est invalide.</div>
						{{ form_errors(form.note) }}
					</div>

					<div class="mb-3">
						{{ form_label(form.comment, null, {'label_attr': {'class': 'form-label'}}) }}
						{{ form_widget(form.comment, {'attr': {'class': 'form-control', 'rows': '3', 'data-validate': 'comment'}}) }}
						<div class="invalid-feedback">Le commentaire est invalide.</div>
						{{ form_errors(form.comment) }}
					</div>

					<button type="submit" class="btn btn-primary w-100" data-spinner-btn>
						<span class="btn-label">Envoyer mon avis</span>
						<span class="btn-spinner p-1 d-none justify-content-center">
							<span class="spinner-border spinner-border-sm" role="status">
								<span class="visually-hidden">Loading...</span>
							</span>
						</span>
					</button>

					{{ form_end(form) }}
				</div>
			</div>
		</div>
	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('review') }}
{% endblock %}