{% extends 'base.html.twig' %}

{% block title %}Laisser un avis{% endblock %}

{% block body %}
    <h1>Laisser un avis</h1>
    <p>Commande du {{ order.deliveryDate|date('d/m/Y') }} — {{ order.menu.title }}</p>

    {{ form_start(form) }}
        {{ form_row(form.note) }}
        {{ form_row(form.comment) }}
        <button type="submit">Envoyer mon avis</button>
    {{ form_end(form) }}

    <a href="{{ path('user_order_detail', {id: order.id}) }}">Retour à ma commande</a>

{% endblock %}