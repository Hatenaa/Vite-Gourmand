{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}
    <h1>Mon espace</h1>

    <a href="{{ path('user_edit_profile') }}">Modifier mon profil</a>

    <h2>Mes commandes</h2>

    {% if orders is empty %}
        <p>Vous n'avez pas encore de commande.</p>
    {% else %}
        {% for order in orders %}
            <div>
                <p>Menu: {{ order.menu.title }}</p>
                <p>Date de livraison: {{ order.deliveryDate|date('d/m/Y') }}</p>
                <p>Statut: {{ order.status }}</p>
                <p>Total: {{ order.totalPrice|number_format(2, '.', ' ') }} €</p>

                <a href="{{ path('user_order_detail', {id: order.id}) }}">Voir le détail</a>

                {% if order.status == 'PENDING' %}
                    <a href="{{ path('user_edit_order', {id: order.id}) }}">Modifier</a>

                    <form method="post" action="{{ path('user_cancel_order', {id: order.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}">
                        <button type="submit">Annuler</button>
                    </form>
                {% endif %}

            </div>
        {% endfor %}
    {% endif %}
{% endblock %}