<header>
	<nav>
		<ul>
			<li>
				<a href="{{ path('home') }}">Accueil</a>
			</li>
			<li>
				<a href="{{ path('menu_index') }}">Menus</a>
			</li>
			<li>
				<a href="{{ path('contact') }}">Contact</a>
			</li>

			{% if app.user %}
				<li>
					<a href="{{ path('user_dashboard') }}">Mon espace</a>
				</li>

				{% if is_granted('ROLE_ADMIN') %}
					<li>
						<a href="{{ path('admin_dashboard') }}">Espace Administrateur</a>
					</li>

				{#
				elseif et non deux if séparés : un ROLE_ADMIN hérite de ROLE_EMPLOYEE
				dans la hiérarchie Symfony, deux if afficheraient les deux liens		
				#}
				{% elseif is_granted('ROLE_EMPLOYEE') %}
					<li>
						<a href="{{ path('employee_dashboard') }}">Espace Employé</a>
					</li>
				{% endif %}

				<li>
					<a href="{{ path('logout') }}">Déconnexion</a>
				</li>
			{% else %}
				<li>
					<a href="{{ path('login') }}">Connexion</a>
				</li>
				<li>
					<a href="{{ path('registration') }}">Inscription</a>
				</li>
			{% endif %}

		</ul>
	</nav>
</header>
