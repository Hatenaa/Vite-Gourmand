<div class="container">
	<footer class="py-3 my-4">

		<ul class="nav justify-content-center pb-3 mb-3">
			{% for group in groups %}
				<li class="nav-item">
					<span class="nav-link px-2 text-body-secondary">
						{% if group.days|length > 1 %}
							{{ group.days|first|slice(0,3) }}–{{ group.days|last|slice(0,3) }}
						{% else %}
							{{ group.days[0]|slice(0,3) }}
						{% endif %}
						:
						{% if group.key == 'closed' %}
							Fermé
						{% else %}
							{{ group.hours.openingTime|date('H:i') }}–{{ group.hours.closingTime|date('H:i') }}
						{% endif %}
					</span>
				</li>
			{% endfor %}

			<li class="nav-item">
				<a href="{{ path('contact') }}" class="nav-link px-2 text-body-secondary">Contact</a>
			</li>
			<li class="nav-item">
				<a href="{{ path('legal_mentions') }}" class="nav-link px-2 text-body-secondary">Mentions légales</a>
			</li>
			<li class="nav-item">
				<a href="{{ path('legal_cgv') }}" class="nav-link px-2 text-body-secondary">CGV</a>
			</li>
			{# 
			On ajoutera un sitemap ici pour une prochaine mise à jour. Important pour le référencement.
			<li class="nav-item">
				<a href="{{ path('sitemap') }}" class="nav-link px-2 text-body-secondary">Sitemap</a>
			</li> #}
		</ul>

		<p class="text-center text-body-secondary">©
			{{ "now"|date("Y") }}
			L'équipe de Vite & Gourmand</p>

	</footer>
</div>
