<footer>
    <h4>Horaires d'ouverture</h4>
    <ul>
        {% for dayHours in openingHours %}
            {% if dayHours and not dayHours.isClosed %}
                <li>
                    {{ dayHours.day }} : 
                    {{ dayHours.openingTime|date('H:i') }} – {{ dayHours.closingTime|date('H:i') }}
                </li>
            {% else %}
                <li>{{ days[loop.index0] }} : Fermé</li>
            {% endif %}
        {% endfor %}
    </ul>

    <p>
        <a href="#">Mentions légales</a> | 
        <a href="#">Conditions générales de vente (CGV)</a>
    </p>
</footer>