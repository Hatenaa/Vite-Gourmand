{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié
{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex align-items-end justify-content-center text-center" style="min-height: 320px;">
		<img src="/images/main/meal-restaurant.jpg" alt="" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>
		<div class="position-relative z-1 py-5 px-3">
			<h1 class="display-4 fw-bold text-white">Réinitialisation du mot de passe</h1>
			{# <p>Entrez votre adresse e-mail pour recevoir un lien de réinitialisation.</p> #}
		</div>
	</section>

	<main class="container pt-4">
		{{ form_start(requestForm) }}

        {{ form_label(requestForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
        <div class="input-group mb-3">
            
            {{ form_widget(requestForm.email, {'attr': {'class': 'form-control', 'placeholder': 'test@mail.fr', 'data-validate': 'email'}}) }}
            <div class="invalid-feedback">Veuillez entrer une adresse email valide.</div>
            {{ form_errors(requestForm.email) }}
            <div class="input-group-append">
                <button class="btn btn-outline-primary rounded-0 rounded-end-3" type="submit">Envoyer</button>
            </div>
        </div>

		{{ form_end(requestForm) }}
		

	</main>
{% endblock %}
