{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex align-items-end justify-content-center text-center" style="min-height: 320px;">
		<img src="/images/main/meal-restaurant.jpg" alt="" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>
		<div class="position-relative z-1 py-5 px-3">
			<h1 class="display-4 fw-bold text-white">Se connecter</h1>
		</div>
	</section>

	<main class="container pt-5">
		<div class="d-flex justify-content-center pb-5">
			<div class="card col-sm-4">
				<div class="p-4 card-body">
					{{ form_start(loginForm, { 'action': path('login_check'), 'attr': {'novalidate': 'novalidate'} }) }}

					<div class="mb-3">
						{{ form_label(loginForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
						{{ form_widget(loginForm.email, {'attr': {'class': 'form-control', 'placeholder': 'test@mail.fr', 'data-validate': 'email'}}) }}
						<div class="invalid-feedback">Veuillez entrer une adresse email valide.</div>
						{{ form_errors(loginForm.email) }}
					</div>

					<div class="mb-3">
						{{ form_label(loginForm.password, null, {'label_attr': {'class': 'form-label'}}) }}
						{{ form_widget(loginForm.password, {'attr': {'class': 'form-control', 'data-validate': 'password'}}) }}
						<div class="invalid-feedback">Le mot de passe ne peut pas être vide.</div>
						{{ form_errors(loginForm.password) }}
					</div>

					<button type="submit" id="submitBtn" class="btn btn-primary w-100" disabled data-spinner-btn>
						<span class="btn-label">Se connecter</span>
						<span class="btn-spinner p-1 d-none justify-content-center">
							<span class="spinner-border spinner-border-sm" role="status">
								<span class="visually-hidden">Loading...</span>
							</span>
						</span>
					</button>

					{{ form_end(loginForm) }}

					<p class="mt-3">
						J'aimerais reintialiser mon
						<a href="{{ path('forgot_password_request') }}" class="text-decoration-none link--flash">mot de passe oublié</a>.
					</p>
				</div>
			</div>
		</div>

	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('signin') }}
{% endblock %}
