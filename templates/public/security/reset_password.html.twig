{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe
{% endblock %}

{% block body %}

	<section class="position-relative overflow-hidden d-flex align-items-end justify-content-center text-center" style="min-height: 320px;">
		<img src="/images/main/meal-restaurant.jpg" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
		<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>
		<div class="position-relative z-1 py-5 px-3">
			<h1 class="display-4 fw-bold text-white">Réinitialisation du mot de passe</h1>
		</div>
	</section>

	<main class="container pt-5">

		{{ form_start(resetForm) }}

		<div class="d-flex justify-content-center pb-5">
			<div class="card col-sm-4">
				<div class="p-4 card-body">

					<div class="mb-3">
						{{ form_label(resetForm.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
						{{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'form-control', 'data-validate': 'firstPassword' }}) }}
						<div class="invalid-feedback">Veuillez entrer un nouveau mot de passe valide.</div>
						{{ form_errors(resetForm.plainPassword.first) }}
					</div>

					<div class="mb-3">
						{{ form_label(resetForm.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
						{{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'form-control', 'data-validate': 'lastPassword' }}) }}
						<div class="invalid-feedback">Votre mot de passe ne correspond pas au premier.</div>
						{{ form_errors(resetForm.plainPassword.second) }}
					</div>

					<button type="submit" class="btn btn-primary w-100" data-spinner-btn>
						<span class="btn-label">Réinitialiser le mot de passe</span>
						<span class="btn-spinner p-1 d-none justify-content-center">
							<span class="spinner-border spinner-border-sm" role="status">
								<span class="visually-hidden">Loading...</span>
							</span>
						</span>
					</button>

				</div>
			</div>
		</div>


		{{ form_end(resetForm) }}

	</main>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('reset-password') }}
{% endblock %}