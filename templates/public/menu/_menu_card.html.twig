<article class="card h-100 border-outline-secondary rounded-4 overflow-hidden">

	{% if menu.images|length > 0 %}
		{% set mainImage = menu.images|first %}
		<div class="position-relative">
			<img src="{{ asset(mainImage.path) }}" alt="{{ mainImage.alt ?? menu.title }}" class="card-img-top object-fit-cover" style="height: 220px;">
			<span class="position-absolute top-0 end-0 m-2 badge bg-dark fw-normal">
				<i class="bi bi-people-fill"></i>
				À partir de
				{{ menu.minPeople }}
				personnes
			</span>
		</div>
	{% endif %}

	<div class="card-body d-flex flex-column p-4">

		<div class="d-flex align-items-baseline gap-2 mb-3">
			<h3 class="fw-bold mb-0 h4">{{ menu.title }}</h3>
			<span class="ms-auto d-flex align-items-baseline gap-1">
				<span class="text-primary fw-bold fs-2 lh-1">{{ menu.basePrice }}€</span>
				<small class="text-muted">/ per.</small>
			</span>
		</div>


		<p class="text-muted text-justify small flex-grow-1">{{ menu.description }}</p>

		<div
			class="d-grid gap-2 mt-3">

			{# Important: le sujet insiste sur la nécessité de vérifier les informations de sa commande.
									Il est donc préférable de rendre le bouton "détail" du menu bien en évidence plutot que celui pour commander
									afin d'être sûr que le client comprenne ce qu'il achète. En e-commerce classique on aurait plutôt
									fait l'inverse. Mais dans ce contexte précis, le détail puis la commande est préférable au schéma opposé. #}

			<a href="{{ path('menu_show', {id: menu.id}) }}" class="btn btn-primary" data-spinner-btn>
				<span class="btn-label">
					Voir en détail
					<i class="bi bi-fork-knife"></i>
				</span>
				<span class="btn-spinner p-1 d-none justify-content-center">
					<span class="spinner-border spinner-border-sm" role="status">
						<span class="visually-hidden">Loading...</span>
					</span>
				</span>
			</a>

			<a href="{{ path('order_new', {'menuId': menu.id}) }}" class="btn btn-outline-secondary" data-spinner-btn>
				<span class="btn-label">Commander ce menu</span>
				<span class="btn-spinner p-1 d-none justify-content-center">
					<span class="spinner-border spinner-border-sm" role="status">
						<span class="visually-hidden">Loading...</span>
					</span>
				</span>
			</a>

		</div>

	</div>
</article>
