{% extends 'base.html.twig' %}

{% block title %}Nos menus
{% endblock %}

{% block stylesheets %}

	{{ encore_entry_link_tags('menu-filters') }}
    {{ parent() }}
{% endblock %}

{% block body %}
	<main>

		{# Hero full-width #}
		<section class="position-relative overflow-hidden d-flex align-items-end justify-content-center text-center" style="min-height: 480px;">
			<img src="{{ asset('images/main/restaurant.jpg') }}" alt="Nos menus - Vite et Gourmand" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
			<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
			<div class="position-relative z-1 py-5 px-3">
				<h1 class="display-4 fw-bold text-white">Nos menus</h1>
				<p class="lead text-white">Choisissez un menu selon votre événement,<br class="d-none d-md-inline">
					votre budget et le nombre de personnes.</p>
			</div>
		</section>

		<div
			class="container py-5">

			{# Bouton déclencheur offcanvas #}
			<div class="d-flex justify-content-end mb-4">
				<button class="btn btn-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
					Filtrer les résultats
				</button>
			</div>

			{# Offcanvas filtres #}
			<div class="offcanvas offcanvas-end" id="filterOffcanvas" tabindex="-1" aria-labelledby="filterOffcanvasLabel">
				<div class="offcanvas-header">
					<h5 class="offcanvas-title" id="filterOffcanvasLabel">Filtrer les menus</h5>
					<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
				</div>
				<div class="offcanvas-body">
					<form id="menu-filter-form" class="container p-4 d-flex flex-column gap-4">

						<div>
							<div class="d-flex justify-content-between mb-2">
								<span class="fw-semibold">Personnes</span>
								<span class="text-muted small">
									<span id="peopleMinLabel">1</span>
									–
									<span id="peopleMaxLabel">500</span>
								</span>
							</div>
							<div id="peopleSlider"></div>
						</div>

						<div>
							<div class="d-flex justify-content-between mb-2">
								<span class="fw-semibold">Prix</span>
								<span class="text-muted small">
									<span id="priceMinLabel">0 €</span>
									–
									<span id="priceMaxLabel">300 €</span>
								</span>
							</div>
							<div id="priceSlider"></div>
						</div>

						<div>
							<button type="button" class="btn btn-link p-0 text-dark text-decoration-none fw-semibold d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" data-bs-target="#themeCollapse" aria-expanded="false">
								Thème
								<i class="bi bi-chevron-down filter-chevron"></i>
							</button>
							<div class="collapse mt-2" id="themeCollapse">
								<select id="theme" name="theme" class="form-select">
									<option value="">Tous les thèmes</option>
									{% for theme in themes %}
										<option value="{{ theme.id }}">{{ theme.label }}</option>
									{% endfor %}
								</select>
							</div>
						</div>

						<div>
							<button type="button" class="btn btn-link p-0 text-dark text-decoration-none fw-semibold d-flex align-items-center gap-2 collapsed" data-bs-toggle="collapse" data-bs-target="#regimeCollapse" aria-expanded="false">
								Régime
								<i class="bi bi-chevron-down filter-chevron"></i>
							</button>
							<div class="collapse mt-2" id="regimeCollapse">
								<select id="regime" name="regime" class="form-select">
									<option value="">Tous les régimes</option>
									{% for regime in regimes %}
										<option value="{{ regime.id }}">{{ regime.label }}</option>
									{% endfor %}
								</select>
							</div>
						</div>

						<button type="submit" class="btn btn-primary w-100">Filtrer les menus</button>
					</form>

				</div>
			</div>

			{# Liste des menus #}
			<div id="menus-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
				{% for menu in menus %}
					<div class="col">
						{% include 'public/menu/_menu_card.html.twig' with { menu: menu } %}
					</div>
				{% else %}
					<p class="col text-muted">Aucun menu disponible.</p>
				{% endfor %}
			</div>

	</div>
</main>

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('menu-filters') }}
{% endblock %}{% endblock %}
